<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/DSub2000.DialogContent"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/admin.add_user_username">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/username"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="text"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/admin.add_user_email">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/email"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="textEmailAddress"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/admin.add_user_password"
		app:endIconMode="password_toggle">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="textPassword"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/settings_list"
		android:layout_width="match_parent"
		android:layout_height="0dip"
		android:layout_marginTop="8dp"
		android:layout_weight="1.0"
		android:scrollbars="vertical"/>
</LinearLayout>
