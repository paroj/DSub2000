<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/DSub2000.DialogContent"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/common.name">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/get_share_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="text"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		android:id="@+id/get_share_expire_layout"
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/share.expiration"
		app:endIconMode="custom"
		app:endIconDrawable="@drawable/ic_action_calendar">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/get_share_expire"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="none"
			android:focusable="false"
			android:cursorVisible="false"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/get_share_no_expire"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="@string/share.no_expiration"
		android:checked="false"/>
</LinearLayout>
