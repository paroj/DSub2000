<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/main_toolbar"
		android:layout_height="?attr/actionBarSize"
		android:layout_width="match_parent"
		android:background="?attr/actionbarBackgroundColor"
		android:elevation="4dp"
		android:theme="?attr/actionbarThemeStyle"
		app:popupTheme="?attr/actionbarPopupStyle"/>

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<!-- The switch labels are set in EditPlayActionActivity, without their trailing colon -->
		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="16dp">

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/edit_shuffle_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:longClickable="true"/>

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/edit_start_year_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:longClickable="true"
				android:enabled="false"/>

			<github.paroj.dsub2000.view.FormTextInputLayout
				android:id="@+id/edit_start_year_layout"
				style="@style/Widget.DSub2000.TextField"
				android:hint="@string/shuffle.startYear"
				android:enabled="false">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/edit_start_year"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="number"/>
			</github.paroj.dsub2000.view.FormTextInputLayout>

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/edit_end_year_checkbox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:longClickable="true"
				android:enabled="false"/>

			<github.paroj.dsub2000.view.FormTextInputLayout
				android:id="@+id/edit_end_year_layout"
				style="@style/Widget.DSub2000.TextField"
				android:hint="@string/shuffle.endYear"
				android:enabled="false">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/edit_end_year"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="number"/>
			</github.paroj.dsub2000.view.FormTextInputLayout>

			<github.paroj.dsub2000.view.FormTextInputLayout
				android:id="@+id/edit_genre_layout"
				style="@style/Widget.DSub2000.TextField.Dropdown"
				android:layout_marginTop="24dp"
				android:hint="@string/tasker.edit_shuffle_genre"
				android:enabled="false">

				<com.google.android.material.textfield.MaterialAutoCompleteTextView
					android:id="@+id/edit_genre_spinner"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="none"
					android:focusable="false"/>
			</github.paroj.dsub2000.view.FormTextInputLayout>

			<github.paroj.dsub2000.view.FormTextInputLayout
				style="@style/Widget.DSub2000.TextField.Dropdown"
				android:layout_marginTop="16dp"
				android:hint="@string/tasker.edit_server_offline">

				<com.google.android.material.textfield.MaterialAutoCompleteTextView
					android:id="@+id/edit_offline_spinner"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="none"/>
			</github.paroj.dsub2000.view.FormTextInputLayout>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
