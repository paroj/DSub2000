<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	style="@style/DSub2000.DialogContent"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/shuffle.startYear">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/start_year"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="number"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/shuffle.endYear">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/end_year"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="number"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		android:id="@+id/genre_layout"
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/shuffle.genre">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/genre"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="text"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		android:id="@+id/genre_combo_layout"
		style="@style/Widget.DSub2000.TextField.Dropdown"
		android:hint="@string/shuffle.genre">

		<com.google.android.material.textfield.MaterialAutoCompleteTextView
			android:id="@+id/genre_combo"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="none"
			android:focusable="false"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>
</LinearLayout>
