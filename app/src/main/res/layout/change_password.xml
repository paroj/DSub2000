<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/DSub2000.DialogContent"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content">

	<github.paroj.dsub2000.view.FormTextInputLayout
		android:id="@+id/current_password_layout"
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/admin.change_password_current_label"
		app:endIconMode="password_toggle">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/current_password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="textPassword"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>

	<github.paroj.dsub2000.view.FormTextInputLayout
		style="@style/Widget.DSub2000.TextField"
		android:hint="@string/admin.change_password_label"
		app:endIconMode="password_toggle">

		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/new_password"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="textPassword"/>
	</github.paroj.dsub2000.view.FormTextInputLayout>
</LinearLayout>
